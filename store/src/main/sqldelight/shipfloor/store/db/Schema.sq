CREATE TABLE card (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    column_name TEXT NOT NULL
);

CREATE TABLE event (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    id TEXT NOT NULL UNIQUE,
    card_id TEXT NOT NULL REFERENCES card(id),
    at TEXT NOT NULL,
    actor TEXT NOT NULL,
    type TEXT NOT NULL,
    payload_json TEXT NOT NULL
);

CREATE INDEX event_card_id ON event(card_id);

CREATE INDEX event_type_at ON event(type, at);

CREATE INDEX event_card_type_actor ON event(card_id, type, seq, actor);

CREATE TABLE spec (
    card_id TEXT NOT NULL PRIMARY KEY,
    path TEXT NOT NULL,
    hash TEXT NOT NULL
);

CREATE TABLE card_reference (
    card_id TEXT NOT NULL REFERENCES card(id),
    position INTEGER NOT NULL,
    provider TEXT NOT NULL,
    external_id TEXT NOT NULL,
    url TEXT NOT NULL,
    imported_at TEXT NOT NULL,
    text_hash TEXT NOT NULL,
    PRIMARY KEY (card_id, provider, external_id)
);

CREATE TABLE card_project (
    card_id TEXT NOT NULL PRIMARY KEY REFERENCES card(id),
    repo TEXT NOT NULL
);

CREATE TABLE project (
    repo_path TEXT NOT NULL PRIMARY KEY,
    registered_at TEXT NOT NULL
);

insertProject:
INSERT OR IGNORE INTO project (repo_path, registered_at) VALUES (:repoPath, :registeredAt);

allProjects:
SELECT repo_path FROM project ORDER BY rowid;

upsertProject:
INSERT OR REPLACE INTO card_project (card_id, repo) VALUES (:cardId, :repo);

projectByCard:
SELECT repo FROM card_project WHERE card_id = :cardId;

deleteReferences:
DELETE FROM card_reference WHERE card_id = :cardId;

insertReference:
INSERT INTO card_reference (card_id, position, provider, external_id, url, imported_at, text_hash)
VALUES (:cardId, :position, :provider, :externalId, :url, :importedAt, :textHash);

referencesByCard:
SELECT provider, external_id, url, imported_at, text_hash FROM card_reference WHERE card_id = :cardId ORDER BY position;

upsertSpec:
INSERT OR REPLACE INTO spec(card_id, path, hash) VALUES (?, ?, ?);

selectSpec:
SELECT path, hash FROM spec WHERE card_id = ?;

insertCardIfAbsent:
INSERT OR IGNORE INTO card (id, title, column_name)
VALUES (:id, :title, :column_name);

updateCard:
UPDATE card SET title = :title, column_name = :column_name WHERE id = :id;

insertEvent:
INSERT INTO event (id, card_id, at, actor, type, payload_json)
VALUES (:id, :cardId, :at, :actor, :type, :payloadJson);

eventPayloadsByCard:
SELECT payload_json FROM event WHERE card_id = :cardId ORDER BY seq;

eventSeqById:
SELECT seq FROM event WHERE id = :id;

eventsAfter:
SELECT seq, card_id, payload_json FROM event WHERE seq > :seq ORDER BY seq;

latestEvents:
SELECT seq, card_id, payload_json FROM event ORDER BY seq DESC LIMIT :limit;

costEventsBetween:
SELECT seq, card_id, payload_json FROM event
WHERE type = 'RUN_COST_RECORDED' AND at >= :fromAt AND at < :toAt
ORDER BY seq;

lastSeqByType:
SELECT MAX(seq) FROM event WHERE card_id = :cardId AND type = :type;

lastSeqByTypeAndActor:
SELECT MAX(seq) FROM event WHERE card_id = :cardId AND type = :type AND actor = :actor;

allCards:
SELECT id, title, column_name FROM card ORDER BY rowid;

cardById:
SELECT title, column_name FROM card WHERE id = :id;
